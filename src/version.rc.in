#include <winver.h>
// Real Windows VERSIONINFO shown in Explorer for ISO-WCX.wcx/.wcx64.
1 VERSIONINFO
 FILEVERSION @ISO_WCX_VERSION_FILE@
 PRODUCTVERSION @ISO_WCX_VERSION_FILE@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS @ISO_WCX_VERSION_FLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ISO-WCX\0"
            VALUE "FileDescription", "ISO-WCX Total Commander WCX plugin\0"
            VALUE "FileVersion", "@ISO_WCX_VERSION_DISPLAY@\0"
            VALUE "ProductVersion", "@ISO_WCX_VERSION_DISPLAY@\0"
            VALUE "ProductName", "ISO-WCX\0"
            VALUE "OriginalFilename", "@ISO_WCX_WCX_BINARY_NAME@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
